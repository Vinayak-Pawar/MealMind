{"nodes": [{"id": "readme_mealmind", "label": "MealMind", "file_type": "document", "source_file": "README.md", "source_location": "README.md:1-3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Positioned as an AI-powered recipe recommendation system that goes beyond text search by combining computer vision (ingredient detection from a camera) with generative AI (recipe images and cooking videos); the stated value is turning what a user physically has on hand into an actionable, media-rich recipe."}, {"id": "readme_smart_recipe_recommendations", "label": "Smart Recipe Recommendations", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recipes are suggested from the set of ingredients the user actually has, rather than from free-text queries, so the recommender is constrained by real pantry state."}, {"id": "readme_ingredient_detection", "label": "Ingredient Detection (camera-based)", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:9,17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real-time object detection is chosen over manual ingredient entry to remove data-entry friction; this is why camera access is listed as a hard prerequisite."}, {"id": "readme_recipe_video_generation", "label": "Recipe Video Generation", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:10,18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cooking tutorial videos are generated on demand via Google Flow instead of curated/licensed video, trading determinism and cost for unlimited per-recipe coverage."}, {"id": "readme_recipe_image_generation", "label": "Recipe Image Generation", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:11,19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recipe photography is synthesized with Nano-Banana rather than sourced from a stock library, so every generated or long-tail recipe still gets a plated image."}, {"id": "readme_nutrition_tracking", "label": "Nutrition Tracking", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "readme_dietary_management", "label": "Dietary Management", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dietary preferences and restrictions act as a filter layer over recommendations, which implies the recommender must be constraint-aware rather than purely similarity-driven."}, {"id": "readme_shopping_list_generation", "label": "Shopping List Generation", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Closes the loop opposite to ingredient detection: detection tells the system what the user has, the shopping list derives what is missing for a chosen recipe."}, {"id": "readme_computer_vision", "label": "Computer Vision Subsystem", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "readme_recommender_system", "label": "ML Recommender System", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:20,131", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Machine-learning based rather than rule-based matching, with trained models kept out of the app tree under ml_models/recommender_system so training and serving artifacts are versioned separately from application code."}, {"id": "readme_layered_backend_architecture", "label": "Layered Backend Architecture (routes / services / models / schemas)", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:109-147", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The backend is split into routes/ (HTTP surface), services/ (business logic and third-party AI integrations), models/ (SQLAlchemy persistence), schemas/ (Pydantic validation) and utils/. Each external AI provider is isolated behind a single service module so the route layer never touches a vendor SDK directly, which keeps provider swaps (Google Flow, Nano-Banana) local to one file."}, {"id": "readme_camera_service", "label": "camera_service (Camera / Computer Vision service)", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:132", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "readme_video_service", "label": "video_service (Google Flow integration)", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:133", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "readme_image_service", "label": "image_service (Nano-Banana integration)", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:134", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "readme_nutrition_service", "label": "nutrition_service (Nutrition calculations)", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:135", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "readme_recommender_service", "label": "recommender service module", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:131", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "readme_fastapi", "label": "FastAPI", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen as a modern async web framework; the README leans on its built-in OpenAPI docs endpoint (/docs) as the API documentation surface, avoiding a separately maintained API spec."}, {"id": "readme_uvicorn", "label": "Uvicorn / Gunicorn ASGI serving", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:86-93", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Development runs bare uvicorn with --reload; production runs gunicorn with 4 UvicornWorker processes to get process-level parallelism and supervision that a single uvicorn process does not provide."}, {"id": "readme_sqlalchemy", "label": "SQLAlchemy ORM", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "readme_alembic_migrations", "label": "Alembic Migrations", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:75-82,145", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single migration chain (alembic upgrade head) is used for both SQLite dev and PostgreSQL prod, with the target selected only by DATABASE_URL in .env, so schema drift between environments is avoided."}, {"id": "readme_dual_database_strategy", "label": "Dual Database Strategy (SQLite dev / PostgreSQL prod)", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:38-40,48,75-82", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL is the primary/production database but is made optional for contributors, with SQLite as the zero-setup development fallback; the trade-off is lower onboarding cost in exchange for dialect differences that the ORM is expected to absorb."}, {"id": "readme_postgresql", "label": "PostgreSQL", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:39", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "readme_sqlite", "label": "SQLite (development database)", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:40", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "readme_opencv", "label": "OpenCV", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "readme_tensorflow_pytorch", "label": "TensorFlow / PyTorch", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both frameworks are declared rather than one, which keeps model-format choice open per subsystem (detection vs recommendation) at the cost of a much heavier dependency footprint."}, {"id": "readme_google_flow_api", "label": "Google Flow API", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "readme_nano_banana_api", "label": "Nano-Banana API", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "readme_react_frontend", "label": "React.js Frontend", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:34,148-166", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frontend is a separate React SPA on port 3000 talking to the API on port 8000, keeping the ML/AI backend fully decoupled from the UI runtime."}, {"id": "readme_material_ui", "label": "Material-UI", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "readme_axios", "label": "Axios HTTP Client", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "readme_ingredient_detector_component", "label": "IngredientDetector / Camera UI components", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:152-159", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "readme_ml_models_directory", "label": "ml_models/ (detection, recommender, training scripts)", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:167-170", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Model weights and training scripts live outside backend/app so training code is never shipped with the serving application and models can be retrained independently of API releases."}, {"id": "readme_data_directory", "label": "data/ (recipes, ingredients, nutrition datasets)", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:171-174", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "readme_docker_deployment", "label": "Docker Deployment (split backend/frontend images)", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:178-181", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separate Dockerfile.backend and Dockerfile.frontend composed via docker-compose keep the heavy ML backend image independent of the lightweight Node/React build image."}, {"id": "readme_apache_2_0_license", "label": "Apache-2.0 License", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:187-189", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "readme_mealmind", "target": "readme_smart_recipe_recommendations", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:8", "weight": 1.0}, {"source": "readme_mealmind", "target": "readme_ingredient_detection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:9", "weight": 1.0}, {"source": "readme_mealmind", "target": "readme_recipe_video_generation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:10", "weight": 1.0}, {"source": "readme_mealmind", "target": "readme_recipe_image_generation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:11", "weight": 1.0}, {"source": "readme_mealmind", "target": "readme_nutrition_tracking", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:12", "weight": 1.0}, {"source": "readme_mealmind", "target": "readme_layered_backend_architecture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:109-147", "weight": 1.0}, {"source": "readme_mealmind", "target": "readme_apache_2_0_license", "relation": "references"